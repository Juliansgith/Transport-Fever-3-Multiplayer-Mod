# Text files are stored with LF endings whatever the platform, so a file
# saved on Windows does not rewrite every line of it.
* text=auto eol=lf
# Test fixtures that are executable images, never text.
*.pe binary
# Windows batch files need CRLF, or cmd misreads some of their lines.
*.bat text eol=crlf
# Windows command scripts need CRLF too.
*.cmd text eol=crlf
