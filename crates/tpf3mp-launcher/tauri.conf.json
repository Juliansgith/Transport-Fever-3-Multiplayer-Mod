{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TPF3-MP",
  "identifier": "io.github.juliansgith.tpf3mp",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TPF3-MP",
        "width": 1060,
        "height": 860,
        "minWidth": 700,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#161719"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
